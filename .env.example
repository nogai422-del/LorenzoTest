# ============================================================
# Lorenzo / Bothost
# ============================================================

# Telegram Bot API.
# Bothost normally injects BOT_TOKEN automatically for Telegram bots.
BOT_TOKEN=put_your_bot_token_here

# Telegram numeric user ID of the system owner. Required on first launch.
OWNER_ID=123456789


# ============================================================
# Persistent storage
# ============================================================
# Bothost keeps /app/data between redeploys. The app also uses <project>/data
# automatically when running locally.
# Usually not needed: on Bothost <project>/data is /app/data automatically.
# DATA_DIR=/app/data
# DATABASE_PATH=/app/data/bot.db


# ============================================================
# Web Admin
# ============================================================
WEB_ENABLED=1
WEB_HOST=0.0.0.0

# Bothost sets PORT automatically from the port selected in the hosting panel.
# For local development you may uncomment WEB_PORT=8080.
# WEB_PORT=8080

# Emergency/initial Owner login. After you create a personal Owner web account
# in Web Admin -> Administrators, WEB_ADMIN_PASSWORD may be removed from ENV.
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=replace_with_a_long_unique_password

# Recommended. If omitted, Lorenzo generates a persistent secret in /app/data.
WEB_SECRET_KEY=replace_with_a_long_random_secret
WEB_SESSION_TTL_SECONDS=43200

# Bothost sets DOMAIN automatically when a domain is enabled, so this can stay
# empty there. Use WEB_PUBLIC_URL only to override the generated public URL.
WEB_PUBLIC_URL=

# Optional override. With a Bothost HTTPS domain this is detected automatically.
# WEB_COOKIE_SECURE=1


# ============================================================
# Telethon
# ============================================================
TELETHON_ENABLED=1

# Easiest option: leave these empty and configure everything from
# Web Admin -> Telethon (API ID -> API Hash -> phone -> code -> 2FA).
TELETHON_API_ID=
TELETHON_API_HASH=

# Bothost-compatible aliases are also supported:
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

# Optional: if you already have a Telethon StringSession, put it in Bothost's
# environment as SESSION_STRING. Never commit the real value to Git.
# SESSION_STRING=

TELETHON_SYNC_INTERVAL_SECONDS=300
TELETHON_DISCOVERY_INTERVAL_SECONDS=1800
TELETHON_HISTORY_DAYS=30
TELETHON_HISTORY_MAX_MESSAGES=50000
TELETHON_HISTORY_OVERLAP_SECONDS=600

# Bothost note:
# PORT and DOMAIN are normally injected by the platform. Do not add them unless
# you intentionally override the hosting settings. Set main file to: main.py
